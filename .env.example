# Browser endpoint (safe to expose; contains no API key).
VITE_AI_NOTES_ENDPOINT=http://localhost:8787/api/lecture-notes

# Optional separate endpoint for lecture Q&A. If omitted, the notes endpoint is reused.
VITE_AI_QA_ENDPOINT=http://localhost:8787/api/lecture-qa

# Server-only settings. Never put GEMINI_API_KEY in a VITE_* variable.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_SERVER_PORT=8787
